RP_ENVIRONMENT=development
# Structured JSON logs to stdout only: DEBUG|INFO|WARNING|ERROR (default INFO).
# This changes verbosity, not redaction: credentials are always filtered.
RP_LOG_LEVEL=INFO
# Application database ONLY: users, jobs and other NEW application tables.
# Default local SQLite; migrations must never target the source database.
RP_DATABASE_URL=sqlite:///.scratch/development.db

# Optional application MySQL: comment RP_DATABASE_URL above before enabling.
# Split credentials support @ : / # % characters without manual URL escaping.
# RP_DATABASE_MYSQL__HOST=127.0.0.1
# RP_DATABASE_MYSQL__PORT=3306
# RP_DATABASE_MYSQL__DATABASE=research_app
# RP_DATABASE_MYSQL__USERNAME=research_app
# RP_DATABASE_MYSQL__PASSWORD='replace-privately'
# RP_DATABASE_MYSQL__TLS=verify
# RP_DATABASE_MYSQL__CA_FILE=C:/private/certs/database-ca.pem

# Optional EXTERNAL research source (MySQL/TiDB); disabled until fully configured.
# Dedicated server-enforced SELECT-only account; never copy a write/admin account.
# RP_SOURCE_MYSQL__HOST=your-source-host
# RP_SOURCE_MYSQL__PORT=4000
# RP_SOURCE_MYSQL__DATABASE=your_existing_source_database
# RP_SOURCE_MYSQL__USERNAME=your_select_only_user
# RP_SOURCE_MYSQL__PASSWORD='replace-privately'
# RP_SOURCE_MYSQL__TLS=verify
# RP_SOURCE_MYSQL__CA_FILE=C:/private/certs/source-ca.pem
# RP_SOURCE_MYSQL__CONNECT_TIMEOUT=10
# RP_SOURCE_MYSQL__READ_TIMEOUT=60

# TLS modes: verify (chain + hostname) | verify_ca (chain only, hostname not
# checked -- MySQL VERIFY_CA; required for MySQL 8 auto-generated server certs,
# which carry no subjectAltName) | disabled (plaintext, isolated local dev only).
# CA_FILE: required by verify_ca, optional for verify (unset = OS trusted roots).
# Never commit .env or store source credentials in frontend code.

# Historical market-review reads use RP_SOURCE_MYSQL__* and four legacy tables
# (index_daily, limit_up_records, stock_daily_prices, market_data). The source
# account must be SELECT-only. Coverage is row presence, not a completeness claim.
# RP_REVIEW__CACHE_SECONDS=60
# RP_REVIEW__MAX_WINDOW=120
# RP_REVIEW__MAX_RANGE_DAYS=366
# RP_REVIEW__LOOKBACK_DAYS=400

# Public market data (Tencent/Sina/Yahoo/Naver quotes and K lines).
# Read-only outbound access, bounded and briefly cached; no key is required.
# RP_UPSTREAM__ENABLED=true
# RP_UPSTREAM__TIMEOUT_SECONDS=10
# RP_UPSTREAM__MAX_RETRIES=1
# RP_UPSTREAM__MIN_INTERVAL_MS=200
# RP_UPSTREAM__QUOTE_CACHE_SECONDS=5
# RP_UPSTREAM__INTRADAY_CACHE_SECONDS=30
# RP_UPSTREAM__GLOBAL_OVERVIEW_REFRESH_SECONDS=60
# RP_UPSTREAM__GLOBAL_HISTORY_REFRESH_SECONDS=3600
# Optional per-host address pin, for a local fake-ip proxy (Clash/Surge TUN mode)
# that answers DNS with 198.18.x.x but cannot complete that host's TLS handshake.
# Only pin a host you verified; TLS still checks the certificate against the
# hostname, so a wrong address fails loudly instead of silently proxying.
# RP_UPSTREAM__HOST_ADDRESSES={"push2his.eastmoney.com": ["119.3.232.150"]}

# Tushare daily bars (optional). The token is a secret: it is never logged nor
# returned to a client. Leave unset to keep /api/v1/market/daily disabled.
# Old-project TUSHARE_TOKEN / MINIO_* are NOT inherited automatically.
# RP_TUSHARE__TOKEN='replace-privately'
# RP_TUSHARE__URL=https://api.tushare.pro

# ---- Built-in registration / login -----------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# RP_AUTH__SECRET='replace-with-48-plus-random-characters'
# RP_AUTH__SESSION_TTL_HOURS=168
# RP_AUTH__SESSION_COOKIE=rp_session
# RP_AUTH__COOKIE_SECURE=true
# RP_AUTH__MAX_FAILED_LOGINS=5
# RP_AUTH__LOCKOUT_MINUTES=15
# RP_AUTH__MIN_PASSWORD_LENGTH=10
# Registration mode: open | invite | closed.
#   invite (default) - a single-use invitation code is required; issue one with
#                      `uv run python tools/project.py identity --identity-action invite-create`
#   closed          - no self-registration; create accounts from the CLI
#   open            - anyone may register (trusted, private deployments only)
# RP_AUTH__REGISTRATION=invite
# RP_AUTH__INVITATION_TTL_HOURS=336

# ---- Artifact storage (S3-compatible, e.g. MinIO) --------------------------
# Migrated from the legacy project: run artifacts live here, metadata in the app
# database. The bucket must already exist; a run is never reported as succeeded
# when its artifacts could not be stored. Leave unset to disable artifact storage.
# RP_OBJECT_STORAGE__ENDPOINT=127.0.0.1
# RP_OBJECT_STORAGE__PORT=9000
# RP_OBJECT_STORAGE__USE_SSL=false
# RP_OBJECT_STORAGE__BUCKET=research
# RP_OBJECT_STORAGE__ACCESS_KEY='replace-privately'
# RP_OBJECT_STORAGE__SECRET_KEY='replace-privately'
