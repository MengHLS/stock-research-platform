# 服务器端部署变量样例。复制为 deploy/.env（已被 .gitignore 忽略）后填写。
# 权限收紧：chmod 600 deploy/.env
#
# 这份文件只给 deploy/compose.server.yaml 与 deploy/deploy.sh 用，
# 与本机开发模板 deploy/compose.yaml 的变量不是同一套，不要互相覆盖。

# ---- 镜像仓库（GitHub Container Registry）-----------------------------------
# Actions 推送 ghcr.io/<owner>/research-platform-api 与 -web，标签为提交 SHA。
# owner 必须小写（镜像名不允许大写）。
IMAGE_PREFIX=ghcr.io/你的github用户名

# 仅手工部署且镜像为私有包时需要；CI 会通过 stdin 预先登录，不必在此保存。
# GHCR_USERNAME=你的GitHub用户名
# GHCR_PASSWORD='仅需 read:packages 权限的 PAT'

# ---- 对外端口 ----------------------------------------------------------------
# ECS 安全组需放行同一端口。纯 HTTP 环境请勿对外暴露 3306/8000。
RP_WEB_PORT=80

# ---- 应用库（SQLite，与本地开发同构）-----------------------------------------
# 文件落在 Docker 卷 research-platform-server_sqlite-data，容器内为 /app/data/app.db。
# 与本地 RP_DATABASE_URL=sqlite:///.scratch/development.db 同一套语义，通常无需修改。
# RP_DATABASE_URL=sqlite:////app/data/app.db

# ---- 研究源（既有 MySQL 实例，只读账号）---------------------------------------
# 与原项目共用一个 MySQL 实例，但只读它自己的库，且账号必须是数据库端 SELECT-only。
# 应用库不能与源库同地址：config.py 会拒绝启动。
MYSQL_NETWORK=mysql_default
RP_SOURCE_MYSQL_HOST=mysql
RP_SOURCE_MYSQL_PORT=3306
RP_SOURCE_MYSQL_DATABASE=vwwjfde663dhej4tohvzpq
RP_SOURCE_MYSQL_USERNAME=research_ro
RP_SOURCE_MYSQL_PASSWORD='replace-privately'
# 仅容器内网通信；该实例用自签证书，公网链路不得沿用 disabled。
RP_SOURCE_MYSQL_TLS=disabled

# ---- 身份认证 ----------------------------------------------------------------
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
RP_AUTH__SECRET='replace-with-48-plus-random-characters'
# 当前 dev 环境用公网 IP + HTTP 访问，必须为 false。
# 一旦接入域名与 HTTPS，改为 true，并把 RP_ENVIRONMENT 改为 production。
RP_AUTH__COOKIE_SECURE=false
RP_AUTH__REGISTRATION=invite
RP_AUTH__SESSION_TTL_HOURS=168

# ---- 运行环境 ----------------------------------------------------------------
# dev 站点按 development 运行：production 会强制 cookie_secure 与 HTTPS 语义，
# 与“公网 IP + 端口”的访问方式冲突。生产发布前再切换。
RP_ENVIRONMENT=development
RP_LOG_LEVEL=INFO

# ---- 可选外部数据源 ----------------------------------------------------------
# 默认关闭：空值被 env_ignore_empty 丢弃，HOST/DATABASE/USERNAME/PASSWORD
# 四项留空即不构造研究源；PORT 留空用 3306。
# 历史复盘总览启用时填写；生产账号必须由数据库端强制 SELECT-only。
RP_SOURCE_MYSQL_HOST=
RP_SOURCE_MYSQL_PORT=
RP_SOURCE_MYSQL_DATABASE=
RP_SOURCE_MYSQL_USERNAME=
RP_SOURCE_MYSQL_PASSWORD=
RP_SOURCE_MYSQL_TLS=
RP_SOURCE_MYSQL_CA_FILE=
# 启用时填 PORT=3306（TiDB 可能为4000）并完整填写账号字段。
# TLS 三种：verify（链+主机名，默认）| verify_ca（只校验链，等价 MySQL VERIFY_CA）|
# disabled（明文，仅限本机隔离环境）。TLS 留空等于 verify，不是“关闭加密”。
# MySQL 8 自动生成的服务器证书没有 subjectAltName，主机名校验必然失败，只能选
# verify_ca。CA_FILE 必须是容器内可读路径（挂载示例见 compose.server.yaml）：
# verify_ca 留空即启动报配置错误，verify 留空则用系统信任根。
RP_REVIEW_CACHE_SECONDS=60
RP_REVIEW_MAX_WINDOW=120
RP_REVIEW_MAX_RANGE_DAYS=366
RP_REVIEW_LOOKBACK_DAYS=400

# Tushare 日线（可选）。token 是密钥，不会写日志也不会返回给前端。
# RP_TUSHARE__TOKEN='replace-privately'
