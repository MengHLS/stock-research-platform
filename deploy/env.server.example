# 服务器端部署变量样例。复制为 deploy/.env（已被 .gitignore 忽略）后填写。
# 权限收紧：chmod 600 deploy/.env
#
# 这份文件只给 deploy/compose.server.yaml 与 deploy/deploy.sh 用，
# 与本机开发模板 deploy/compose.yaml 的变量不是同一套，不要互相覆盖。

# ---- 镜像仓库（GitHub Container Registry）-----------------------------------
# Actions 推送 ghcr.io/<owner>/research-platform-api 与 -web，标签为提交 SHA。
# owner 必须小写（镜像名不允许大写）。
IMAGE_PREFIX=ghcr.io/你的github用户名

# 仅手工部署且镜像为私有包时需要；CI 会通过 stdin 预先登录，不必在此保存。
# GHCR_USERNAME=你的GitHub用户名
# GHCR_PASSWORD='仅需 read:packages 权限的 PAT'

# ---- 对外端口 ----------------------------------------------------------------
# ECS 安全组需放行同一端口。纯 HTTP 环境请勿对外暴露 3306/8000。
RP_WEB_PORT=80

# ---- 应用数据库（复用 ECS 既有 MySQL 实例，不新建容器）-----------------------
# MYSQL_NETWORK 是既有 MySQL 容器所在的 Docker 网络，MYSQL_HOST 是其容器名。
# research 库与 research 账号独立，不读写既有其他库。
MYSQL_HOST=mysql
MYSQL_NETWORK=mysql_default
MYSQL_DATABASE=research
MYSQL_USER=research
MYSQL_PASSWORD='replace-privately'

# ---- 身份认证 ----------------------------------------------------------------
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
RP_AUTH__SECRET='replace-with-48-plus-random-characters'
# 当前 dev 环境用公网 IP + HTTP 访问，必须为 false。
# 一旦接入域名与 HTTPS，改为 true，并把 RP_ENVIRONMENT 改为 production。
RP_AUTH__COOKIE_SECURE=false
RP_AUTH__REGISTRATION=invite
RP_AUTH__SESSION_TTL_HOURS=168

# ---- 运行环境 ----------------------------------------------------------------
# dev 站点按 development 运行：production 会强制 cookie_secure 与 HTTPS 语义，
# 与“公网 IP + 端口”的访问方式冲突。生产发布前再切换。
RP_ENVIRONMENT=development
RP_LOG_LEVEL=INFO

# ---- 可选外部数据源 ----------------------------------------------------------
# 默认关闭。研究源必须是数据库端强制的 SELECT-only 账号。
# RP_SOURCE_MYSQL__HOST=
# RP_SOURCE_MYSQL__PORT=4000
# RP_SOURCE_MYSQL__DATABASE=
# RP_SOURCE_MYSQL__USERNAME=
# RP_SOURCE_MYSQL__PASSWORD='replace-privately'
# RP_SOURCE_MYSQL__TLS=verify

# Tushare 日线（可选）。token 是密钥，不会写日志也不会返回给前端。
# RP_TUSHARE__TOKEN='replace-privately'
