{
  "name": "research-platform-web",
  "description": "磐石 Quant Lab — A 股量化研究工作台前端",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../.scratch/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^5.4.0",
    "pinia": "^3.0.0",
    "element-plus": "^2.10.0",
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^8.3.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.0.0",
    "vitest": "^5.0.0",
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "openapi-typescript": "^7.8.0",
    "@types/node": "^24.0.0"
  }
}
